PORT=8787
NODE_ENV=production

# Keep app login OFF when sharing with friends only.
REQUIRE_AUTH=false

# Gate with signed invite codes that expire automatically.
REQUIRE_INVITE_CODE=true
INVITE_CODE_SECRET=change-this-to-a-long-random-string
INVITE_CODE_TTL_DAYS=7
INVITE_COOKIE_NAME=gbl_invite

# Disable shared-password mode when invite mode is on.
REQUIRE_SITE_PASSWORD=false
SITE_USER=
SITE_PASSWORD=

# If REQUIRE_AUTH=true, provide both values below.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional CORS allowlist (comma-separated). Leave empty in dev.
ALLOWED_ORIGINS=
# Example:
# ALLOWED_ORIGINS=https://your-domain.com

# Optional: external player similarity catalog (disabled by default).
# Keep max requests below provider cap (500/hour), default is 450/hour.
NBA2K_API_ENABLED=false
NBA2K_API_BASE_URL=https://api.nba2kapi.com
NBA2K_API_PLAYERS_PATH=/api/players/bulk
NBA2K_API_KEY=
NBA2K_API_KEY_HEADER=X-API-Key
NBA2K_API_TIMEOUT_MS=4500
NBA2K_API_MAX_REQUESTS_PER_HOUR=450
NBA2K_SIMILARITY_CACHE_TTL_MS=21600000
